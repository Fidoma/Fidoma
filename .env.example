APP_NAME="ERP Fidoma"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FIDOMA_REPOSITORY_URL=https://github.com/Fidoma/Fidoma
FIDOMA_DOCUMENTATION_URL=https://github.com/Fidoma/Fidoma#readme
FIDOMA_CONTACT_URL=
FIDOMA_CLOUD_URL=
FIDOMA_SUPPORT_URL=
FIDOMA_DONATION_URL=
FIDOMA_IMPRINT_URL=
FIDOMA_PRIVACY_URL=
APP_PORT=8000
FORWARD_PHPMYADMIN_PORT=8081
WWWUSER=1000
WWWGROUP=1000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME="rechnung@example.com"
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="rechnung@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_VERIFY_CERTIFICATES=true

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SCHEME=ssl
IMAP_USERNAME="rechnung@example.com"
IMAP_PASSWORD=null
IMAP_MAILBOX=INBOX
IMAP_VERIFY_CERTIFICATES=true
ROUNDCUBE_PRIVATE_DIR=

PAPERLESS_URL=
PAPERLESS_TOKEN=
PAPERLESS_STORAGE_PATH_ID=
PAPERLESS_DOCUMENT_TYPE_ID=
PAPERLESS_AMOUNT_FIELD_ID=
PAPERLESS_INVOICE_NUMBER_FIELD_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
