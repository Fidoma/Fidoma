APP_NAME="Fidoma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:5555

DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=

FIDOMA_REPOSITORY_URL=https://github.com/Fidoma/Fidoma
FIDOMA_DOCUMENTATION_URL=https://github.com/Fidoma/Fidoma#readme
FIDOMA_CONTACT_EMAIL=info@fidoma.de
FIDOMA_CONTACT_FROM_EMAIL=info@fidoma.de
CONTACT_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
FIDOMA_DONATION_URL=https://www.paypal.com/ncp/payment/4J8LA2Z8TNGNQ
FIDOMA_PAYPAL_DONATION_URL=https://www.paypal.com/ncp/payment/4J8LA2Z8TNGNQ
FIDOMA_IMPRINT_URL=
FIDOMA_PRIVACY_URL=

# Docker Compose
FIDOMA_IMAGE=ghcr.io/fidoma/fidoma:latest
FIDOMA_PORT=5555
FIDOMA_PHPMYADMIN_BIND_ADDRESS=127.0.0.1
FIDOMA_PHPMYADMIN_PORT=5556
FIDOMA_DB_DATABASE=fidoma
FIDOMA_DB_USERNAME=fidoma
FIDOMA_DB_PASSWORD=
FIDOMA_DB_ROOT_PASSWORD=

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fidoma
DB_USERNAME=fidoma
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@fidoma.de
MAIL_FROM_NAME="${APP_NAME}"
MAIL_VERIFY_CERTIFICATES=true

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SCHEME=ssl
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_VERIFY_CERTIFICATES=true
ROUNDCUBE_PRIVATE_DIR=/var/www/html/storage/app/private/roundcube

PAPERLESS_URL=
PAPERLESS_TOKEN=
PAPERLESS_STORAGE_PATH_ID=
PAPERLESS_DOCUMENT_TYPE_ID=
PAPERLESS_AMOUNT_FIELD_ID=
PAPERLESS_INVOICE_NUMBER_FIELD_ID=

TERMINAL_GATEWAY_URL=http://host.docker.internal:5000
TERMINAL_GATEWAY_TOKEN=
TERMINAL_GATEWAY_TIMEOUT=130
TERMINAL_GATEWAY_STATUS_TIMEOUT=10
TERMINAL_PAYMENT_METHOD_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
