APP_NAME="Fidoma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:5555
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fidoma
DB_USERNAME=fidoma
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=info@fidoma.de
MAIL_FROM_NAME="${APP_NAME}"

FIDOMA_CONTACT_URL=mailto:info@fidoma.de
FIDOMA_CLOUD_URL="mailto:info@fidoma.de?subject=Fidoma%20Cloud"
FIDOMA_SUPPORT_URL="mailto:info@fidoma.de?subject=Fidoma%20Support"
FIDOMA_DONATION_URL=https://www.paypal.com/ncp/payment/4J8LA2Z8TNGNQ

PAPERLESS_URL=
PAPERLESS_TOKEN=
PAPERLESS_STORAGE_PATH_ID=
PAPERLESS_DOCUMENT_TYPE_ID=
PAPERLESS_AMOUNT_FIELD_ID=
PAPERLESS_INVOICE_NUMBER_FIELD_ID=

TERMINAL_GATEWAY_URL=http://host.docker.internal:5000
TERMINAL_GATEWAY_TOKEN=
